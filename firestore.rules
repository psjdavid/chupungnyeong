rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 공개 읽기 (홈페이지에서 데이터 조회)
    match /notices/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sermons/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gallery/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /programs/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 문의: 누구나 쓰기, 관리자만 읽기/수정
    match /inquiries/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
